  "info": {
    "_postman_id": "885c6861-8405-4ea1-8145-c0c2dacf7eea",
    "name": "Load, Generation, and Interchange Historical API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Provides load, generation, and interchange data. Load: Includes demand, load, and load forecast. Generation: Includes generation cleared and offered as well as related data. Interchange: Includes Energy transfers that cross Balancing Authority (BA) Area boundaries. Note: Data available within the interchange endpoints are subject to change up to 105 days after the market day due to reconciliation.",
      "type": "text/plain"
    }
  }
