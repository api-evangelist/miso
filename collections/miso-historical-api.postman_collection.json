          "name": "Historical Net Scheduled Interchange",
          "request": {
            "name": "Historical Net Scheduled Interchange",
            "description": {
              "content": "Net scheduled interchange (NSI) final volumes, by adjacent balancing authority (BA) in hourly intervals. Includes updates from Dynamic Schedules, Emergency Power Purchases, and ARS/CRSG events. Positive values indicate imports. Available at 7am EST the day after. May be updated up to 105 days after-the-fact.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "historical",
                ":date",
                "interchange",
                "net-scheduled"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "adjacentBa",
                  "value": "<string>",
                  "description": "Filter to a specific adjacent Balancing Authority (ex. PJM, TVA, SWPP)."
                },
                {
                  "disabled": false,
                  "key": "interval",
                  "value": "<string>",
                  "description": "Filter to a specific time interval (ex. \"13:05\", \"13\"), in Eastern Standard Time (UTC−05:00)."
                },
                {
                  "disabled": false,
                  "key": "pageNumber",
                  "value": "1"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<date>",
                  "key": "date",
                  "description": "(Required) Market date in the form: yyyy-mm-dd"
                }
              ]
            },
            "header": [
